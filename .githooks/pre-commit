#!/usr/bin/env bash

set -euo pipefail

clang_format="${CLANG_FORMAT:-clang-format}"

if ! command -v "$clang_format" >/dev/null 2>&1; then
    echo "pre-commit: clang-format was not found. Install it or set CLANG_FORMAT."
    exit 1
fi

while IFS= read -r -d '' file; do
    case "$file" in
        external/*)
            continue
            ;;
        *.c|*.cc|*.cpp|*.cxx|*.h|*.hh|*.hpp|*.hxx)
            ;;
        *)
            continue
            ;;
    esac

    if ! git diff --quiet -- "$file"; then
        echo "pre-commit: $file has unstaged changes; stage or stash them before committing."
        exit 1
    fi

    "$clang_format" -i -- "$file"
    git add -- "$file"
done < <(git diff --cached --name-only --diff-filter=ACMR -z)
