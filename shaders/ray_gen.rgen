#version 460
#extension GL_EXT_ray_tracing : require

layout(set = 0, binding = 0) uniform accelerationStructureEXT topAS;
layout(set = 0, binding = 1, rgba8)   uniform image2D outputImage;
layout(set = 0, binding = 3, rgba32f) uniform image2D accumImage;

layout(push_constant) uniform PC { uint frameAccum; } pc;

// ── 路径追踪 payload ──────────────────────────────────────────────────────────
struct HitPayload {
    vec3  attenuation;
    vec3  nextOrigin;
    vec3  nextDir;
    bool  scatter;
};
layout(location = 0) rayPayloadEXT HitPayload payload;

// ── PCG 随机数 ────────────────────────────────────────────────────────────────
uint rng;
uint pcg() {
    rng = rng * 747796405u + 2891336453u;
    uint w = ((rng >> ((rng >> 28u) + 4u)) ^ rng) * 277803737u;
    return (w >> 22u) ^ w;
}
float rand01()  { return float(pcg()) / 4294967295.0; }
float rand11()  { return rand01() * 2.0 - 1.0; }
vec3 randInUnitSphere() {
    vec3 p;
    for (int i = 0; i < 8; ++i) {
        p = vec3(rand11(), rand11(), rand11());
        if (dot(p, p) < 1.0) break;
    }
    return p;
}

// ── RTIOW 相机（Book 1 最终场景参数） ────────────────────────────────────────
const vec3  lookfrom   = vec3(13.0, 2.0, 3.0);
const vec3  lookat     = vec3(0.0, 0.0, 0.0);
const vec3  vup        = vec3(0.0, 1.0, 0.0);
const float vfov       = 20.0;
const float aperture   = 0.1;
const float focusDist  = 10.0;

void main() {
    float theta    = radians(vfov);
    float h        = tan(theta * 0.5);
    float aspect   = float(gl_LaunchSizeEXT.x) / float(gl_LaunchSizeEXT.y);
    float vpH      = 2.0 * h;
    float vpW      = aspect * vpH;

    vec3 w = normalize(lookfrom - lookat);
    vec3 u = normalize(cross(vup, w));
    vec3 v = cross(w, u);

    vec3 horizontal  = focusDist * vpW * u;
    vec3 vertical    = focusDist * vpH * v;
    vec3 lowerLeft   = lookfrom - horizontal*0.5 - vertical*0.5 - focusDist*w;
    float lensRadius = aperture * 0.5;

    const int SAMPLES    = 4;
    const int MAX_BOUNCE = 8;
    vec3 pixelColor = vec3(0.0);

    for (int s = 0; s < SAMPLES; ++s) {
        rng = gl_LaunchIDEXT.x
            + gl_LaunchIDEXT.y * gl_LaunchSizeEXT.x
            + uint(s) * 1013904223u
            + pc.frameAccum * 1664525u    // 每帧不同种子
            + 1664525u;
        pcg(); pcg();

        vec2 jitter = vec2(rand01(), rand01());
        vec2 uv = (vec2(gl_LaunchIDEXT.xy) + jitter) / vec2(gl_LaunchSizeEXT.xy);
        uv.y = 1.0 - uv.y; // Vulkan Y 朝下，翻转使相机坐标正确

        float rd    = lensRadius * rand01();
        float angle = rand01() * 6.28318;
        vec3 offset = (cos(angle)*u + sin(angle)*v) * rd;

        vec3 rayOrigin = lookfrom + offset;
        vec3 rayDir    = normalize(lowerLeft + uv.x*horizontal + uv.y*vertical - rayOrigin);

        vec3 throughput  = vec3(1.0);
        vec3 sampleColor = vec3(0.0);

        for (int bounce = 0; bounce < MAX_BOUNCE; ++bounce) {
            payload.scatter = false;
            traceRayEXT(topAS,
                        gl_RayFlagsOpaqueEXT,
                        0xFF,
                        0, 0, 0,
                        rayOrigin, 0.001,
                        rayDir, 1e6,
                        0);
            if (!payload.scatter) {
                sampleColor = throughput * payload.attenuation;
                break;
            }
            throughput *= payload.attenuation;
            rayOrigin   = payload.nextOrigin;
            rayDir      = payload.nextDir;
        }
        pixelColor += sampleColor;
    }
    pixelColor /= float(SAMPLES);

    // ── 跨帧累积（移动平均）─────────────────────────────────────────────────
    vec3 accumulated;
    if (pc.frameAccum == 0u) {
        accumulated = pixelColor;
    } else {
        vec4 prev = imageLoad(accumImage, ivec2(gl_LaunchIDEXT.xy));
        float w0  = 1.0 / float(pc.frameAccum + 1u);
        accumulated = mix(prev.xyz, pixelColor, w0);
    }
    imageStore(accumImage, ivec2(gl_LaunchIDEXT.xy), vec4(accumulated, 1.0));

    // ── Gamma 2 校正后写入展示图像 ──────────────────────────────────────────
    vec3 display = sqrt(clamp(accumulated, vec3(0.0), vec3(1.0)));
    imageStore(outputImage, ivec2(gl_LaunchIDEXT.xy), vec4(display, 1.0));
}
