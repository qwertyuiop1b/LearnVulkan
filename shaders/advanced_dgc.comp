#version 450

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;
struct ObjectData { vec4 positionScale; vec4 color; };
layout(std430, set = 0, binding = 0) writeonly buffer Objects { ObjectData data[]; } objects;
layout(std430, set = 0, binding = 1) buffer IndirectCommand {
    uint vertexCount;
    uint instanceCount;
    uint firstVertex;
    uint firstInstance;
} command;
layout(push_constant) uniform AdvancedPush { vec4 p[8]; } pc;

uint hashUint(uint x) {
    x ^= x >> 16u; x *= 0x7feb352du; x ^= x >> 15u; x *= 0x846ca68bu; return x ^ (x >> 16u);
}
float random01(uint x) { return float(hashUint(x)) / 4294967295.0; }

void main() {
    uint index = gl_GlobalInvocationID.x;
    uint objectCount = uint(pc.p[5].x + 0.5);
    if (index >= objectCount)
        return;
    if (index == 0u) {
        command.vertexCount = 6u;
        command.instanceCount = objectCount;
        command.firstVertex = 0u;
        command.firstInstance = 0u;
    }
    uint width = uint(ceil(sqrt(float(objectCount))));
    uvec2 cell = uvec2(index % width, index / width);
    vec2 normalized = (vec2(cell) + 0.5) / float(width) - 0.5;
    float angle = pc.p[4].w * (0.18 + random01(index) * 0.42) + random01(index + 1u) * 6.2831853;
    vec3 position = vec3(normalized.x * 18.0 + sin(angle) * 0.35,
                         normalized.y * 10.0 + cos(angle * 1.3) * 0.35,
                         -2.0 - random01(index + 2u) * 9.0);
    float scale = mix(0.07, 0.24, random01(index + 3u));
    vec3 color = 0.45 + 0.55 * cos(float(index) * 0.37 + vec3(0.0, 2.1, 4.2));
    objects.data[index].positionScale = vec4(position, scale);
    objects.data[index].color = vec4(color, 1.0);
}
