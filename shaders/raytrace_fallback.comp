#version 450

// Software fallback for platforms without VK_KHR_ray_tracing_pipeline.
// Every invocation traces one primary ray against analytic spheres and a plane.
layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;
layout(set = 0, binding = 0, rgba8) uniform writeonly image2D outputImage;

layout(push_constant) uniform PushConstants {
    uint width;
    uint height;
    uint frame;
} pc;

struct Hit {
    float distance;
    vec3 normal;
    vec3 color;
    float reflectivity;
};

bool hitSphere(vec3 origin, vec3 direction, vec3 center, float radius, vec3 color, float reflectivity, inout Hit hit) {
    vec3 oc = origin - center;
    float halfB = dot(oc, direction);
    float c = dot(oc, oc) - radius * radius;
    float discriminant = halfB * halfB - c;
    if (discriminant < 0.0)
        return false;
    float root = -halfB - sqrt(discriminant);
    if (root < 0.001 || root >= hit.distance) {
        root = -halfB + sqrt(discriminant);
        if (root < 0.001 || root >= hit.distance)
            return false;
    }
    vec3 position = origin + root * direction;
    hit.distance = root;
    hit.normal = normalize(position - center);
    hit.color = color;
    hit.reflectivity = reflectivity;
    return true;
}

bool hitGround(vec3 origin, vec3 direction, inout Hit hit) {
    if (abs(direction.y) < 0.0001)
        return false;
    float distance = (-1.0 - origin.y) / direction.y;
    if (distance < 0.001 || distance >= hit.distance)
        return false;
    vec3 position = origin + distance * direction;
    float checker = mod(floor(position.x) + floor(position.z), 2.0);
    hit.distance = distance;
    hit.normal = vec3(0.0, 1.0, 0.0);
    hit.color = mix(vec3(0.12), vec3(0.75), checker);
    hit.reflectivity = 0.08;
    return true;
}

vec3 sky(vec3 direction) {
    float t = 0.5 * (direction.y + 1.0);
    return mix(vec3(0.08, 0.10, 0.18), vec3(0.45, 0.68, 0.95), t);
}

vec3 trace(vec3 origin, vec3 direction) {
    Hit hit;
    hit.distance = 1e20;
    hitSphere(origin, direction, vec3(-1.15, -0.15, -3.8), 0.85, vec3(0.85, 0.16, 0.10), 0.12, hit);
    hitSphere(origin, direction, vec3(0.10, -0.35, -2.7), 0.65, vec3(0.10, 0.50, 0.90), 0.45, hit);
    hitSphere(origin, direction, vec3(1.30, 0.15, -4.4), 1.0, vec3(0.18, 0.82, 0.32), 0.18, hit);
    hitGround(origin, direction, hit);
    if (hit.distance == 1e20)
        return sky(direction);

    vec3 lightDirection = normalize(vec3(-0.6, 1.0, 0.45));
    float diffuse = max(dot(hit.normal, lightDirection), 0.0);
    vec3 lit = hit.color * (0.13 + 0.87 * diffuse);
    vec3 reflected = sky(reflect(direction, hit.normal));
    return mix(lit, reflected, hit.reflectivity);
}

void main() {
    uvec2 pixel = gl_GlobalInvocationID.xy;
    if (pixel.x >= pc.width || pixel.y >= pc.height)
        return;
    vec2 uv = (vec2(pixel) + 0.5) / vec2(pc.width, pc.height);
    uv.y = 1.0 - uv.y; // Vulkan image coordinates grow downward.
    vec2 screen = uv * 2.0 - 1.0;
    screen.x *= float(pc.width) / float(pc.height);
    vec3 origin = vec3(0.0, 0.2, 1.7);
    vec3 direction = normalize(vec3(screen, -1.65));
    vec3 color = trace(origin, direction);
    imageStore(outputImage, ivec2(pixel), vec4(color, 1.0));
}
