#version 450
// ═══════════════════════════════════════════════════════════════════════════
// 顶点着色器：三角形（顶点坐标硬编码）
//
// 每个顶点调用一次，gl_VertexIndex 是当前顶点的索引（0/1/2）
// 无需顶点缓冲，直接从数组取坐标
// ═══════════════════════════════════════════════════════════════════════════

// NDC（归一化设备坐标）坐标系：
//   X: -1（左）到 +1（右）
//   Y: -1（上）到 +1（下）  ← 注意：Vulkan Y轴朝下！
//   Z:  0（近）到  1（远）
vec2 positions[3] = vec2[](
    vec2( 0.0, -0.5),   // 顶部中央
    vec2( 0.5,  0.5),   // 右下
    vec2(-0.5,  0.5)    // 左下
);

// 每个顶点对应的颜色（传递给片段着色器插值）
vec3 colors[3] = vec3[](
    vec3(1.0, 0.0, 0.0),   // 红
    vec3(0.0, 1.0, 0.0),   // 绿
    vec3(0.0, 0.0, 1.0)    // 蓝
);

// layout(location = N) out：输出给片段着色器的变量
// 光栅化阶段会对三角形内部的像素自动插值
layout(location = 0) out vec3 fragColor;

void main()
{
    // gl_Position 是内建变量，必须赋值，表示顶点的裁剪空间坐标
    gl_Position = vec4(positions[gl_VertexIndex], 0.0, 1.0);
    fragColor   = colors[gl_VertexIndex];
}
