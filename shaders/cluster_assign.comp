#version 450
// 第76章：聚簇前向着色 — 将点光源分配到 3D 格子
layout(local_size_x=8, local_size_y=8, local_size_z=4) in;

struct PointLight {
    vec4 posRadius;   // xyz=位置, w=半径
    vec4 color;       // xyz=颜色, w=强度
};

layout(set=0,binding=0) readonly buffer LightSSBO {
    PointLight lights[];
};

// 每个 Cluster 的光源列表
layout(set=0,binding=1) buffer ClusterLightCount {
    uint lightCount[];     // [clusterIdx] = 本 cluster 内光源数
};
layout(set=0,binding=2) buffer ClusterLightList {
    uint lightList[];      // [clusterIdx * MAX_LIGHTS_PER_CLUSTER + n] = lightIdx
};

layout(push_constant) uniform ClusterPC {
    mat4  invProj;
    vec2  screenSize;
    float nearZ, farZ;
    ivec3 clusterCount;    // (16, 9, 24) 典型值
    int   lightCount;
    int   maxLightsPerCluster;
} pc;

// 将 Cluster 坐标转换为视空间 AABB
void clusterToAABB(ivec3 coord, out vec3 aabbMin, out vec3 aabbMax) {
    vec2 tileSize = pc.screenSize / vec2(pc.clusterCount.xy);
    vec2 uvMin = vec2(coord.xy) * tileSize / pc.screenSize;
    vec2 uvMax = (vec2(coord.xy)+1.0) * tileSize / pc.screenSize;

    // 深度切片（对数分布）
    float sliceNear = pc.nearZ * pow(pc.farZ/pc.nearZ, float(coord.z)   /float(pc.clusterCount.z));
    float sliceFar  = pc.nearZ * pow(pc.farZ/pc.nearZ, float(coord.z+1) /float(pc.clusterCount.z));

    // NDC → 视空间
    vec4 ndcMin = vec4(uvMin*2.0-1.0, 0.0, 1.0);
    vec4 ndcMax = vec4(uvMax*2.0-1.0, 0.0, 1.0);
    vec4 vsMin  = pc.invProj * ndcMin; vsMin /= vsMin.w;
    vec4 vsMax  = pc.invProj * ndcMax; vsMax /= vsMax.w;

    aabbMin = vec3(vsMin.xy, -sliceFar);
    aabbMax = vec3(vsMax.xy, -sliceNear);
}

// 球 vs AABB 相交检测
bool sphereAABB(vec3 center, float radius, vec3 bMin, vec3 bMax) {
    vec3 closest = clamp(center, bMin, bMax);
    return length(center - closest) < radius;
}

void main() {
    ivec3 coord = ivec3(gl_GlobalInvocationID);
    if (any(greaterThanEqual(coord, pc.clusterCount))) return;

    uint clusterIdx = uint(coord.x + coord.y*pc.clusterCount.x
                         + coord.z*pc.clusterCount.x*pc.clusterCount.y);
    vec3 bMin, bMax;
    clusterToAABB(coord, bMin, bMax);

    uint count = 0;
    for (int i = 0; i < pc.lightCount && count < uint(pc.maxLightsPerCluster); ++i) {
        vec3  lpos = lights[i].posRadius.xyz;
        float lrad = lights[i].posRadius.w;
        if (sphereAABB(lpos, lrad, bMin, bMax)) {
            lightList[clusterIdx * uint(pc.maxLightsPerCluster) + count] = uint(i);
            ++count;
        }
    }
    lightCount[clusterIdx] = count;
}
