#version 450
layout(local_size_x=64)in;layout(set=0,binding=0,std430)buffer Data{vec4 values[];}data;layout(push_constant)uniform Push{vec4 p[8];}pc;
void main(){uint id=gl_GlobalInvocationID.x;if(id>=1024u)return;float x=float(id)/1023.;float froxel=exp(-x*2.)*(.5+.5*sin(x*17.+pc.p[0].z));float cloud=.5+.5*sin(x*8.+sin(pc.p[0].z*.2)*3.);float fft=.5+.5*sin(x*12.-pc.p[0].z*.5)+.1*sin(x*41.);float caustic=pow(max(0.,sin(x*28.+pc.p[0].z*2.)),8.);data.values[id]=vec4(froxel,cloud,fft,caustic);}
