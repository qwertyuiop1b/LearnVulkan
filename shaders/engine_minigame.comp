#version 450

layout(local_size_x = 64) in;
struct Entity { vec4 positionRadius; vec4 colorType; };
layout(set = 0, binding = 0, std430) buffer Entities { Entity entities[]; };
layout(push_constant) uniform Push { vec4 p[8]; } pc;

float hash11(float x) { return fract(sin(x*91.17)*43758.5453); }

void main() {
    uint id = gl_GlobalInvocationID.x;
    uint total = uint(pc.p[1].z);
    if (id >= total) return;
    float t = pc.p[0].z * pc.p[1].x;
    if (id == 0u) {
        entities[id].positionRadius = vec4(sin(t)*2.4, 0.72, -4.0+cos(t*0.7)*1.8, 0.62);
        entities[id].colorType = vec4(0.1,0.75,1.0,0.0);
        return;
    }
    float fi = float(id);
    float ring = 2.2 + floor(fi/12.0)*1.45;
    float angle = fi*2.39996 + t*(0.18+hash11(fi)*0.18);
    vec2 center = entities[0].positionRadius.xz;
    vec2 xz = center + vec2(cos(angle),sin(angle))*ring;
    float y = 0.35 + abs(sin(t*2.2+fi))*0.22;
    entities[id].positionRadius = vec4(xz.x,y,xz.y,0.24+hash11(fi+8.0)*0.16);
    entities[id].colorType = vec4(mix(vec3(1.0,0.12,0.04),vec3(1.0,0.72,0.08),hash11(fi)),1.0);
}
