#version 450
layout(local_size_x=64) in;
layout(set=0,binding=0,std430) buffer Data { vec4 values[]; } data;
layout(set=0,binding=1,std430) buffer History { vec4 values[]; } history;
layout(push_constant) uniform Push { vec4 p[8]; } pc;
void main(){ uint id=gl_GlobalInvocationID.x; if(id>=1024u)return; float x=(float(id)+.5)/1024.; float scale=pc.p[1].x; float low=.5+.42*sin(x*18.+pc.p[0].z); float jitter=sin(pc.p[0].z*1.7)*.5+.5; float previous=history.values[id].z; float reconstructed=mix(low,previous,.72)*scale+.5*(1.-scale); float sharpen=clamp(reconstructed+(reconstructed-.5)*pc.p[1].y,0.,1.); data.values[id]=vec4(low,previous,reconstructed,sharpen); history.values[id]=vec4(low,previous,reconstructed,sharpen); }
