#version 450

// A cube is split into six tetrahedra. This keeps the example compact while
// retaining the important marching-cubes property: the mesh is generated
// entirely on the GPU from a sampled scalar field.
layout(local_size_x = 4, local_size_y = 4, local_size_z = 4) in;

struct SurfaceVertex {
    vec4 position;
    vec4 normal;
};

layout(std430, set = 0, binding = 0) writeonly buffer SurfaceBuffer {
    SurfaceVertex vertices[];
} surface;

layout(std430, set = 0, binding = 1) buffer CounterBuffer {
    uint triangleCount;
    uint overflowCount;
    uint activeCellCount;
    uint padding;
} counters;

layout(push_constant) uniform GenerationParams {
    vec4 volume; // half extent, iso level, time, noise frequency
    vec4 shape;  // noise strength, cave strength, lobe blend, reserved
    uvec4 grid;  // cells per axis, maximum triangles, seed, reserved
} pc;

uint hashUint(uint value) {
    value ^= value >> 16u;
    value *= 0x7feb352du;
    value ^= value >> 15u;
    value *= 0x846ca68bu;
    value ^= value >> 16u;
    return value;
}

float hash3(ivec3 p) {
    uint h = hashUint(uint(p.x) ^ (hashUint(uint(p.y)) << 1u) ^ (hashUint(uint(p.z)) << 2u) ^ pc.grid.z);
    return float(h) * (1.0 / 4294967295.0);
}

float valueNoise(vec3 p) {
    ivec3 cell = ivec3(floor(p));
    vec3 f = fract(p);
    vec3 u = f * f * (3.0 - 2.0 * f);

    float n000 = hash3(cell + ivec3(0, 0, 0));
    float n100 = hash3(cell + ivec3(1, 0, 0));
    float n010 = hash3(cell + ivec3(0, 1, 0));
    float n110 = hash3(cell + ivec3(1, 1, 0));
    float n001 = hash3(cell + ivec3(0, 0, 1));
    float n101 = hash3(cell + ivec3(1, 0, 1));
    float n011 = hash3(cell + ivec3(0, 1, 1));
    float n111 = hash3(cell + ivec3(1, 1, 1));

    float nx00 = mix(n000, n100, u.x);
    float nx10 = mix(n010, n110, u.x);
    float nx01 = mix(n001, n101, u.x);
    float nx11 = mix(n011, n111, u.x);
    return mix(mix(nx00, nx10, u.y), mix(nx01, nx11, u.y), u.z);
}

float fbm(vec3 p) {
    float result = 0.0;
    float amplitude = 0.55;
    mat3 rotation = mat3(0.00, 0.80, 0.60,
                         -0.80, 0.36, -0.48,
                         -0.60, -0.48, 0.64);
    for (int octave = 0; octave < 4; ++octave) {
        result += amplitude * valueNoise(p);
        p = rotation * p * 2.03 + vec3(3.1, 1.7, 2.4);
        amplitude *= 0.5;
    }
    return result;
}

float smoothMaximum(float a, float b, float radius) {
    float h = clamp(0.5 + 0.5 * (a - b) / radius, 0.0, 1.0);
    return mix(b, a, h) + radius * h * (1.0 - h);
}

float density(vec3 p) {
    float time = pc.volume.z;
    float body = 3.25 - length(p * vec3(0.84, 1.08, 0.80));

    vec3 lobeA = vec3(1.95, 0.42 + sin(time * 0.48) * 0.12, 0.20);
    vec3 lobeB = vec3(-1.65, -0.72, 0.42 + cos(time * 0.41) * 0.10);
    float a = 1.75 - length((p - lobeA) * vec3(0.92, 1.12, 0.86));
    float b = 1.55 - length((p - lobeB) * vec3(0.88, 0.92, 1.16));
    body = smoothMaximum(body, a, 0.72 * pc.shape.z);
    body = smoothMaximum(body, b, 0.66 * pc.shape.z);

    vec3 noisePosition = p * pc.volume.w + vec3(time * 0.055, -time * 0.036, time * 0.047);
    float rockNoise = (fbm(noisePosition) - 0.48) * 2.0;
    body += rockNoise * pc.shape.x;

    // Curved subtraction fields create a tunnel and a side cavity. Reducing
    // cave strength moves both cutters away from the zero isosurface.
    vec2 tunnelPoint = vec2(p.y + 0.24 + sin(p.x * 0.75 + time * 0.22) * 0.22,
                            p.z - cos(p.x * 0.55 - time * 0.18) * 0.20);
    float tunnel = 0.78 - length(tunnelPoint);
    body = min(body, -tunnel + (1.0 - pc.shape.y) * 1.65);

    vec3 cavityCenter = vec3(-1.25, 0.92, 0.55);
    float cavity = 0.92 - length((p - cavityCenter) * vec3(1.0, 1.25, 0.85));
    body = min(body, -cavity + (1.0 - pc.shape.y) * 1.45);
    return body;
}

vec3 edgeIntersection(vec3 a, vec3 b, float da, float db) {
    float denominator = db - da;
    float t = abs(denominator) > 1e-6 ? (pc.volume.y - da) / denominator : 0.5;
    return mix(a, b, clamp(t, 0.0, 1.0));
}

vec3 surfaceNormal(vec3 p) {
    float epsilon = (pc.volume.x * 2.0 / float(pc.grid.x)) * 0.32;
    vec3 gradient = vec3(density(p + vec3(epsilon, 0, 0)) - density(p - vec3(epsilon, 0, 0)),
                         density(p + vec3(0, epsilon, 0)) - density(p - vec3(0, epsilon, 0)),
                         density(p + vec3(0, 0, epsilon)) - density(p - vec3(0, 0, epsilon)));
    // Positive density is the solid interior, so -gradient points outward.
    return normalize(-gradient + vec3(1e-7));
}

void storeTriangle(vec3 a, vec3 b, vec3 c) {
    vec3 na = surfaceNormal(a);
    vec3 nb = surfaceNormal(b);
    vec3 nc = surfaceNormal(c);
    if (dot(cross(b - a, c - a), na + nb + nc) < 0.0) {
        vec3 positionSwap = b;
        b = c;
        c = positionSwap;
        vec3 normalSwap = nb;
        nb = nc;
        nc = normalSwap;
    }

    uint triangle = atomicAdd(counters.triangleCount, 1u);
    if (triangle >= pc.grid.y) {
        atomicAdd(counters.overflowCount, 1u);
        return;
    }

    uint destination = triangle * 3u;
    float materialA = fbm(a * 0.72 + vec3(5.0));
    float materialB = fbm(b * 0.72 + vec3(5.0));
    float materialC = fbm(c * 0.72 + vec3(5.0));
    surface.vertices[destination + 0u].position = vec4(a, materialA);
    surface.vertices[destination + 0u].normal = vec4(na, 0.0);
    surface.vertices[destination + 1u].position = vec4(b, materialB);
    surface.vertices[destination + 1u].normal = vec4(nb, 0.0);
    surface.vertices[destination + 2u].position = vec4(c, materialC);
    surface.vertices[destination + 2u].normal = vec4(nc, 0.0);
}

void polygoniseTetra(vec3 p0, vec3 p1, vec3 p2, vec3 p3,
                     float d0, float d1, float d2, float d3) {
    vec3 positions[4] = vec3[](p0, p1, p2, p3);
    float values[4] = float[](d0, d1, d2, d3);
    int insideIndices[4];
    int outsideIndices[4];
    int insideCount = 0;
    int outsideCount = 0;
    for (int i = 0; i < 4; ++i) {
        if (values[i] > pc.volume.y)
            insideIndices[insideCount++] = i;
        else
            outsideIndices[outsideCount++] = i;
    }

    if (insideCount == 0 || insideCount == 4)
        return;

    if (insideCount == 1 || insideCount == 3) {
        bool invert = insideCount == 3;
        int isolated = invert ? outsideIndices[0] : insideIndices[0];
        int others[3];
        if (invert) {
            others[0] = insideIndices[0];
            others[1] = insideIndices[1];
            others[2] = insideIndices[2];
        } else {
            others[0] = outsideIndices[0];
            others[1] = outsideIndices[1];
            others[2] = outsideIndices[2];
        }
        vec3 a = edgeIntersection(positions[isolated], positions[others[0]], values[isolated], values[others[0]]);
        vec3 b = edgeIntersection(positions[isolated], positions[others[1]], values[isolated], values[others[1]]);
        vec3 c = edgeIntersection(positions[isolated], positions[others[2]], values[isolated], values[others[2]]);
        storeTriangle(a, b, c);
        return;
    }

    int i0 = insideIndices[0];
    int i1 = insideIndices[1];
    int o0 = outsideIndices[0];
    int o1 = outsideIndices[1];
    vec3 a = edgeIntersection(positions[i0], positions[o0], values[i0], values[o0]);
    vec3 b = edgeIntersection(positions[i0], positions[o1], values[i0], values[o1]);
    vec3 c = edgeIntersection(positions[i1], positions[o1], values[i1], values[o1]);
    vec3 d = edgeIntersection(positions[i1], positions[o0], values[i1], values[o0]);
    storeTriangle(a, b, c);
    storeTriangle(a, c, d);
}

void main() {
    uvec3 cell = gl_GlobalInvocationID.xyz;
    if (any(greaterThanEqual(cell, uvec3(pc.grid.x))))
        return;

    float cellSize = pc.volume.x * 2.0 / float(pc.grid.x);
    vec3 origin = vec3(cell) * cellSize - vec3(pc.volume.x);
    const ivec3 offsets[8] = ivec3[](ivec3(0, 0, 0), ivec3(1, 0, 0),
                                     ivec3(1, 1, 0), ivec3(0, 1, 0),
                                     ivec3(0, 0, 1), ivec3(1, 0, 1),
                                     ivec3(1, 1, 1), ivec3(0, 1, 1));
    vec3 p[8];
    float d[8];
    uint insideCorners = 0u;
    for (int i = 0; i < 8; ++i) {
        p[i] = origin + vec3(offsets[i]) * cellSize;
        d[i] = density(p[i]);
        insideCorners += d[i] > pc.volume.y ? 1u : 0u;
    }
    if (insideCorners == 0u || insideCorners == 8u)
        return;
    atomicAdd(counters.activeCellCount, 1u);

    // Six tetrahedra sharing the 0-6 body diagonal avoid ambiguous cube cases.
    polygoniseTetra(p[0], p[5], p[1], p[6], d[0], d[5], d[1], d[6]);
    polygoniseTetra(p[0], p[1], p[2], p[6], d[0], d[1], d[2], d[6]);
    polygoniseTetra(p[0], p[2], p[3], p[6], d[0], d[2], d[3], d[6]);
    polygoniseTetra(p[0], p[3], p[7], p[6], d[0], d[3], d[7], d[6]);
    polygoniseTetra(p[0], p[7], p[4], p[6], d[0], d[7], d[4], d[6]);
    polygoniseTetra(p[0], p[4], p[5], p[6], d[0], d[4], d[5], d[6]);
}
